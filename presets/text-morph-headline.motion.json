{
  "version": 1,
  "name": "text-morph-headline",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "background": "#0b0b0d",
    "fps": 30,
    "duration": 3
  },
  "typography": {
    "fontFileId": null,
    "fontSize": 120,
    "letterSpacing": 0,
    "lineHeight": 1.2,
    "textAlign": "center"
  },
  "palette": {
    "primary": "#f5f5f0",
    "secondary": "#8a8a8a",
    "accent": "#ff5a36"
  },
  "easing": "easeOutCubic",
  "animation": {
    "type": "textMorph",
    "mode": "character",
    "textA": "Before",
    "textB": "After",
    "holdStart": 0.7,
    "transitionDuration": 0.7,
    "holdEnd": 0.9,
    "color": "#f5f5f0",
    "strokeEnabled": false,
    "strokeColor": "#000000",
    "strokeWidth": 2,
    "loopMode": "loop",
    "staggerMs": 35,
    "direction": "up",
    "blurAmount": 10,
    "scaleFrom": 0.7,
    "scaleTo": 1,
    "opacityEasing": "easeOutCubic",
    "seed": 1
  }
}
